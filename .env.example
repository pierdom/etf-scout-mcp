# etf-scout-mcp configuration. Copy to .env and fill in — never commit the
# real file. Every variable below is read in src/etf_scout_mcp/config.py.

# --- Transport ------------------------------------------------------------
ETF_SCOUT_MCP_TRANSPORT=stdio
# stdio | http. Wrong value: the server refuses to start (unrecognised
# transport falls through to fastmcp's own error). Claude Desktop needs
# stdio; a shared/remote deployment (Docker) needs http.

ETF_SCOUT_MCP_HTTP_HOST=127.0.0.1
# Bind address, http transport only. Wrong/missing: defaults to
# 127.0.0.1, which is unreachable from outside the container — set to
# 0.0.0.0 in Docker or nothing outside the container can connect.

ETF_SCOUT_MCP_HTTP_PORT=8765
# Port, http transport only. Missing: defaults to 8765. Must match the
# port your reverse proxy forwards to and the port published in
# docker-compose.yml.

# --- Auth (http transport only) --------------------------------------------
# Precedence: OIDC_* (below) when config_url/client_id/client_secret/base_url
# are ALL set > this bearer token > refuses to start. stdio needs no auth.

ETF_SCOUT_MCP_HTTP_BEARER_TOKEN=
# Shared secret for machine-to-machine HTTP clients (Claude Code CLI, curl).
# Generate with: openssl rand -hex 32
# Missing (and OIDC_* also unset) while transport=http: server refuses to
# start. Wrong value on the client side: every request gets HTTP 401 with
# WWW-Authenticate: Bearer error="invalid_token".

# --- OIDC / remote OAuth (http transport only) -----------------------------
# For Claude's remote connector (mobile/desktop), which requires Dynamic
# Client Registration — most self-hosted IdPs (e.g. PocketID) don't support
# DCR natively, so FastMCP's OIDCProxy presents a DCR-compliant interface in
# front of the real IdP. See README "OIDC / remote OAuth" for the full setup
# checklist and gotchas. Leave ALL of these unset to disable OIDC entirely
# and fall back to the bearer token above.

OIDC_CONFIG_URL=
# The IdP's OpenID configuration document, e.g.
# https://id.example.com/.well-known/openid-configuration
# Wrong/unreachable: server fails to start OIDCProxy (fetches this at
# startup) — check calls.log / stderr for the fetch error.

OIDC_CLIENT_ID=
# Confidential client ID registered on the IdP.

OIDC_CLIENT_SECRET=
# Confidential client secret. Wrong: login completes on the IdP side then
# fails exchanging the code for a token — symptom is a redirect back to a
# generic "authentication failed" page.

OIDC_BASE_URL=
# This server's own public URL, e.g. https://etf-scout-mcp.example.com — NOT
# the IdP's URL. Used to build the redirect URI
# (OIDC_BASE_URL + OIDC_REDIRECT_PATH), which must exactly match what's
# registered on the IdP or the IdP rejects the auth request outright.

OIDC_REDIRECT_PATH=/auth/callback
# Path appended to OIDC_BASE_URL to form the redirect URI. Register
# <OIDC_BASE_URL><OIDC_REDIRECT_PATH> as an allowed redirect URI on the IdP.

OIDC_REQUIRED_SCOPES=
# Optional, comma-separated (e.g. openid,profile). Leave empty unless your
# IdP requires explicit scope negotiation.

OIDC_ALLOWED_REDIRECT_URIS=
# Optional, comma-separated allowlist for the DCR-registered client
# redirect URIs, e.g. https://claude.ai/*,https://claude.com/*
# Empty: any client-supplied redirect URI is accepted after DCR — fine for
# a personal server, but lock this down if the server is otherwise exposed.

OIDC_VERIFY_ID_TOKEN=false
# true if the IdP issues opaque (non-JWT) access tokens and you want the ID
# token verified instead. Wrong setting for your IdP: token verification
# fails and every login is rejected after the IdP redirect.

OIDC_FORWARD_RESOURCE=false
# RFC 8707 resource-indicator forwarding. PocketID (and many IdPs) reject
# this param outright. true against an IdP that doesn't support it: login
# fails immediately after consent with invalid_request. Only enable for an
# IdP you've confirmed supports RFC 8707.

# --- Cache ------------------------------------------------------------------
ETF_SCOUT_MCP_CACHE=~/.cache/etf-scout-mcp/cache.db
# SQLite cache file path. In Docker, point this inside the mounted volume
# (e.g. /data/cache.db) or the cache — and calls.log, written alongside it —
# is lost on every container recreation.

ETF_SCOUT_MCP_CACHE_ENABLED=true
# false disables the cache entirely — every call hits the upstream source
# every time. Useful for debugging a suspected stale-data issue; leave true
# otherwise, especially for justETF (disabling raises block risk).

ETF_SCOUT_MCP_CACHE_TTL_QUOTE=60
# Yahoo quote cache TTL, seconds. Too high: stale prices. Too low: more
# Yahoo requests, higher rate-limit/block risk.

ETF_SCOUT_MCP_CACHE_TTL_PROFILE=86400
# justETF profile/screener AND OpenFIGI listing cache TTL, seconds (24h
# default). Too low: more justETF scrapes, higher block risk — this data
# changes slowly, 24h is deliberately generous.

ETF_SCOUT_MCP_CACHE_TTL_HISTORY=3600
# OHLCV history cache TTL, seconds (1h default).

# --- Logging ------------------------------------------------------------
ETF_SCOUT_MCP_LOG_LEVEL=INFO
# Standard Python log level (DEBUG/INFO/WARNING/ERROR). Every outbound call
# (justETF, Yahoo, OpenFIGI) and every cache hit/miss is logged to
# <cache dir>/calls.log (rotating, 5MB x 3) — not independently configurable,
# it's always alongside ETF_SCOUT_MCP_CACHE. Too quiet (WARNING+) hides the
# hit/miss and latency detail you need when diagnosing a data-source issue.

# --- OpenFIGI -----------------------------------------------------------
OPENFIGI_API_KEY=
# Optional. Free key from openfigi.com. Missing: rate limit is 25
# requests/minute (shared across get_etf_listings and every ISIN->ticker
# resolution get_quote/get_history/compare_etfs performs); with a key, 25
# requests/6 seconds.
